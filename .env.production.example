# Template only. Inject through the service manager/secret store, not the browser bundle.
# Required externally provisioned TLS database URL; runtime role must not own the schema.
NODE_ENV=production
DATABASE_URL=postgresql://kokoni_runtime:REPLACE_URL_ENCODED_PASSWORD@db.kokoni.example:5432/kokoni?sslmode=verify-full
# Required public HTTPS origins. Replace reserved example domains with your chosen domains.
BETTER_AUTH_URL=https://admin.kokoni.example
STOREFRONT_BASE_URL=https://kokoni.example
# Required, separately generated random secrets, at least 32 characters; use 48 random bytes.
BETTER_AUTH_SECRET=
COMMERCE_GATEWAY_SECRET=
# Required persistent mount, created and writable by the runtime user before starting.
MERCHANDISE_UPLOAD_DIR=/var/lib/kokoni/media
STOREFRONT_PRODUCT_ROUTES_READY=true
ALLOW_DEVELOPMENT_SEED=false
# Existing implementation supports Stripe TEST mode only. Keep disabled on a public launch host.
COMMERCE_TEST_CHECKOUT_ENABLED=false
# Optional unless testing Stripe: externally supplied TEST API key and endpoint signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Existing France mainland / EUR / TTC policy; integer minor units and basis points.
COMMERCE_POLICY_JSON={"version":"fr-mainland-ttc-v1","shippingAmount":590,"freeShippingThreshold":8000,"defaultVatRateBps":2000,"shippingVatRateBps":2000,"reservationMinutes":60}
# Business decision, preserved from existing default. Enable only after email is verified operationally.
CUSTOMER_REQUIRE_VERIFIED_EMAIL=false
# Owner decision, and the setting that wins when present:
#   off   = unverified accounts may check out and pull
#   gacha = gacha pulls and reward claims require a verified address; checkout stays open
#   all   = both checkout and gacha require verification
# Enable anything other than "off" only after provider delivery has actually been tested.
CUSTOMER_VERIFICATION_POLICY=off
# Explicit disabled state until domain/sender/delivery tests pass.
CUSTOMER_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
CUSTOMER_EMAIL_FROM=
CUSTOMER_EMAIL_REPLY_TO=
CUSTOMER_EMAIL_SITE_NAME=Kokoni
# Optional backend alias. If supplied, must match STOREFRONT_BASE_URL.
# SITE_ORIGIN=https://kokoni.example
# Launch switches. Neither flag enables paid gacha; that capability does not exist.
GACHA_DRAWS_ENABLED=false
GACHA_CUSTOMER_EXECUTION_ENABLED=false
