# Local development only. Use separate credentials and secrets in production.
DATABASE_URL=postgresql://kokono:kokono_local_only@localhost:55432/kokono_dev
TEST_DATABASE_URL=postgresql://kokono:kokono_local_only@localhost:55432/kokono_test
BETTER_AUTH_URL=http://localhost:3000
# Generate your own with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Explicit opt-in to synthetic demonstration merchandise; production seeding is refused.
ALLOW_DEVELOPMENT_SEED=false
# Optional persistent image directory. Default: .local/uploads inside the project.
# Use a persistent volume path when deploying this Node/PostgreSQL application.
MERCHANDISE_UPLOAD_DIR=
