# Local development only. Use separate credentials and secrets in production.
# Commerce secrets are server-only. Live Stripe keys are deliberately refused.
COMMERCE_GATEWAY_SECRET=
COMMERCE_TEST_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional complete/partial JSON override; omitted fields use the France-mainland defaults.
# COMMERCE_POLICY_JSON={"shippingAmount":590,"freeShippingThreshold":8000,"defaultVatRateBps":2000,"shippingVatRateBps":2000,"reservationMinutes":60}
DATABASE_URL=postgresql://kokono:kokono_local_only@localhost:55432/kokono_dev
TEST_DATABASE_URL=postgresql://kokono:kokono_local_only@localhost:55432/kokono_test
BETTER_AUTH_URL=http://localhost:3000
# Generate your own with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# Explicit opt-in to synthetic demonstration merchandise; production seeding is refused.
ALLOW_DEVELOPMENT_SEED=false
# Optional persistent image directory. Default: .local/uploads inside the project.
# Use a persistent volume path when deploying this Node/PostgreSQL application.
MERCHANDISE_UPLOAD_DIR=
# Public website origin (also the explicit read-only CORS allowlist). No secrets here.
STOREFRONT_BASE_URL=http://localhost:5173
# Enable only after Prompt 17 provides /products/:slug in the separate website.
STOREFRONT_PRODUCT_ROUTES_READY=false

# Global kill switch for administrator-granted gacha draws. Paid draws remain disabled.
GACHA_DRAWS_ENABLED=true
# Customer accounts have independent database sessions; no admin session/secret is reused.
# True requires verified email for new checkout; enable only after mail setup/manual verification.
CUSTOMER_REQUIRE_VERIFIED_EMAIL=false
# Owner decision, and the setting that wins when present:
#   off   = unverified accounts may check out and pull
#   gacha = gacha pulls and reward claims require a verified address; checkout stays open
#   all   = both checkout and gacha require verification
# Enable anything other than "off" only after provider delivery has actually been tested.
CUSTOMER_VERIFICATION_POLICY=off

# Server-only transactional mail. Explicit opt-in; no mail is sent when disabled.
CUSTOMER_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
CUSTOMER_EMAIL_FROM=
# Optional plain reply-to mailbox; e.g. support@your-verified-domain.example
CUSTOMER_EMAIL_REPLY_TO=
CUSTOMER_EMAIL_SITE_NAME=Kokoni
# Optional alias for STOREFRONT_BASE_URL; when set, both must resolve to the same origin.
# SITE_ORIGIN=https://your-customer-website.example

# Customer gacha is explicitly opt-in and never monetary in this phase.
# Also enable the individual banner and grant an expiring customer free-pull authorization.
GACHA_CUSTOMER_EXECUTION_ENABLED=false
